# Go build artifacts
bin/
*.exe
*.test
*.out

# Project-local Go toolchain and module cache (downloaded by
# scripts/bootstrap-go.sh; isolated from the user's $HOME/go).
.go-toolchain/
.gopath/

# goreleaser snapshot output
dist/

# Dependencies
vendor/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.*

# trond state (local only)
# ~/.trond/ is user-local, not in repo

# Local Claude Code workspace state
.claude/
CLAUDE.md

# Shadow-fork PoC artifacts — generated by scripts/poc-shadow-fork.sh.
# .shadow-fork-witness.env contains a freshly-generated secp256k1
# private key and MUST never be committed; the data dir and templated
# conf/intent files are similarly local-only.
.shadow-fork-witness.env
shadow-fork-data/
shadow-fork.conf
shadow-fork-intent.yaml
